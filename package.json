{
    "name": "@octopus/docs",
    "type": "module",
    "version": "0.0.1",
    "private": true,
    "packageManager": "pnpm@10.13.1",
    "engines": {
        "node": "^22.23.4 || ^24.22.1 || >=26.12.1",
        "pnpm": ">=9.10.0"
    },
    "scripts": {
        "dev": "npm-run-all --parallel dev:img dev:dictionary dev:astro dev:watch",
        "dev:dictionary": "node ./dictionary-sorter.mjs",
        "dev:img": "node ./src/themes/octopus/utilities/img.mjs",
        "dev:astro": "astro dev",
        "dev:watch": "onchange 'src/**/*.{js,mjs,ts,astro,css}' -- prettier --write --plugin=prettier-plugin-astro {{changed}}",
        "astro": "astro",
        "build": "astro build",
        "crawl": "linkinator ./dist --skip \"^(?!http://localhost)\" --recurse  --verbosity error",
        "format": "prettier --write --plugin=prettier-plugin-astro 'src/**/*.{js,mjs,ts,astro,css}'",
        "preview": "astro preview",
        "renovate": "renovate",
        "spellcheck": "git fetch origin main:refs/remotes/origin/main && git diff origin/main --name-only --diff-filter=ACMRTUXB | cspell --no-must-find-files --file-list stdin",
        "spellcheck-all": "cspell \"**/*.{md,mdx}\"",
        "test": "astro build && npx playwright install chromium && npx playwright test",
        "watch": "onchange 'src/**/*.{js,mjs,ts,astro,css}' -- prettier --write --plugin=prettier-plugin-astro {{changed}}"
    },
    "dependencies": {
        "@astrojs/markdown-satteri": "^0.4.6",
        "@astrojs/mdx": "^8.1.2",
        "@octopusdeploy/design-system-tokens": "^2026.3.9109",
        "astro": "^7.4.5",
        "astro-accelerator-utils": "^0.3.116",
        "glob": "^14.0.3",
        "gray-matter": "^4.0.3",
        "optional": "^0.1.4",
        "pagefind": "~1.5.2",
        "satteri": "^0.10.5",
        "sharp": "^0.35.5"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@pnpm/exe": "^11.0.9",
        "cspell": "^10.4.0",
        "csv-parse": "^7.0.3",
        "linkinator": "7.0.0",
        "npm-run-all": "^4.1.5",
        "onchange": "^7.1.0",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.2"
    },
    "pnpm": {
        "overrides": {
            "postcss@<8.4.31": ">=8.4.31",
            "zod@<=3.22.2": ">=3.22.3",
            "esbuild": ">=0.25.0",
            "svgo": ">=4.0.1",
            "devalue": ">=5.6.3",
            "minimatch": ">=10.2.3",
            "rollup": ">=4.59.0",
            "linkinator": "7.0.0"
        }
    }
}