---
import { accelerator } from '@lib/accelerator';
import { Translations, Lang } from '@util/Languages';
import type { Crumb } from '@util/breadcrumbs';

const stats = new accelerator.statistics(
  'octopus/components/Breadcrumbs.astro'
);
stats.start();

// Properties
type Props = {
  lang: string;
  crumbs?: ReadonlyArray<Crumb> | null;
};
const { lang, crumbs } = Astro.props satisfies Props;

// Language
const _ = Lang(lang);

stats.stop();
---

<nav aria-label={_(Translations.aria.breadcrumbs)}>
  <ol>
    {
      (crumbs ?? []).map((crumb) => (
        <li>
          <a
            href={accelerator.urlFormatter.formatAddress(crumb.url)}
            aria-current={crumb.ariaCurrent ? crumb.ariaCurrent : null}
            rel={crumb.rel}
          >
            {crumb.title}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space8);
    list-style: none;
    padding: var(--space6) 0 var(--space0);
  }

  li + li::before {
    content: '/';
    margin-inline-end: var(--space8);
    color: var(--color-text-tertiary);
    font: var(--textBodyRegularSmall);
  }

  a {
    color: var(--color-menu-link);
    font: var(--textBodyRegularMedium);
    text-decoration: none;
    transition: color var(--duration-default) ease-in-out;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  a:hover,
  a:focus {
    color: var(--color-menu-link-alt);
  }
</style>
