---
import { accelerator } from '@lib/accelerator';
import type { NavPage } from 'astro-accelerator-utils/types/NavPage';

const stats = new accelerator.statistics(
  'octopus/components/NavigationItem.astro'
);
stats.start();

// Properties
type Props = {
  lang: string;
  page: NavPage;
  /**
   * Set when this render deliberately left the page's children out, so the
   * link can still advertise that it leads into a section.
   */
  leadsToSection?: boolean;
};
const { lang, page, leadsToSection = false } = Astro.props satisfies Props;

// Logic
const linkTitle = page.title === page.fullTitle ? null : page.fullTitle;
const isExpandable = page.children.length > 0;

// Backstop logic
const displayLink = page.title != null;

stats.stop();
---

{
  displayLink && !isExpandable && (
    <li class="site-nav__list-item">
      <a
        class:list={[
          'site-nav__link',
          { 'site-nav__link--section': leadsToSection },
        ]}
        href={accelerator.urlFormatter.formatAddress(page.url)}
        aria-current={page.ariaCurrent ? page.ariaCurrent : null}
        rel={page.rel}
        title={linkTitle}
      >
        <span class="site-nav__label">{page.title}</span>
      </a>
    </li>
  )
}
{
  displayLink && isExpandable && (
    <li class="site-nav__list-item">
      <details class="site-nav__group" open={page.isOpen}>
        <summary class="site-nav__link">
          <span class="site-nav__label">{page.section}</span>
        </summary>
        <ul class="site-nav__list">
          {page.children
            .sort((a, b) => a.order - b.order)
            .map((page) => (
              <Astro.self lang={lang} page={page} />
            ))}
        </ul>
      </details>
    </li>
  )
}
