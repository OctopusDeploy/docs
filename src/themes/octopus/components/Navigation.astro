---
import { accelerator } from '@lib/accelerator';
import type { NavPage } from 'astro-accelerator-utils/types/NavPage';
import { Translations, Lang } from '@util/Languages';
import NavigationItem from '@components/NavigationItem.astro';
import { applyCurrentPage, menuTemplate } from '@lib/navigationTree';

const stats = new accelerator.statistics('octopus/components/Navigation.astro');
stats.start();

type Props = {
  lang: string;
};
const { lang } = Astro.props satisfies Props;

const _ = Lang(lang);

const currentUrl = new URL(Astro.request.url);

// Expand the current section in place; collapse every other section to a
// labelled link.
const currentPath = currentUrl.pathname.replace(/\/$/, '');
function isOnActivePath(page: NavPage): boolean {
  const pUrl = (page.url ?? '').replace(/\/$/, '');
  if (!pUrl) return false;
  return currentPath === pUrl || currentPath.startsWith(pUrl + '/');
}
function markActiveBranchOpen(items: NavPage[]): void {
  for (const item of items) {
    if (item.children && item.children.length > 0 && isOnActivePath(item)) {
      item.isOpen = true;
      markActiveBranchOpen(item.children);
    }
  }
}

// Only the branch the reader is inside is ever rendered expanded, so clone
// that one branch off the shared template rather than rebuilding the whole
// tree per page. Collapsed sections keep a flag: their children are gone from
// the markup, but the link still needs to read as leading into a section.
const topLevel = menuTemplate().map((top) => {
  const hasChildren = (top.children?.length ?? 0) > 0;
  const expand = hasChildren && isOnActivePath(top);
  return {
    leadsToSection: hasChildren && !expand,
    page: {
      ...top,
      title: hasChildren && !expand && top.section ? top.section : top.title,
      children: expand ? structuredClone(top.children) : [],
    },
  };
});

const pages: NavPage[] = topLevel.map((top) => top.page);

applyCurrentPage(pages, currentUrl);

for (const top of pages) {
  if (top.children.length > 0) {
    top.isOpen = true;
    markActiveBranchOpen(top.children);
  }
}

stats.stop();
---

<nav
  class="site-nav"
  id="site-nav"
  aria-label={_(Translations.aria.site_navigation)}
>
  <h2 class="site-nav-title">{_(Translations.navigation.title)}</h2>
  <ul class="site-nav__list">
    {
      topLevel.map(({ page, leadsToSection }) => (
        <NavigationItem
          lang={lang}
          page={page}
          leadsToSection={leadsToSection}
        />
      ))
    }
  </ul>
</nav>
