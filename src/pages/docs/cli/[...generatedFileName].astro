---
// [...name].astro allows an astro file to sub in for any subpath of this folder. We use this to
// route /docs/cli/something.mdx to /docs/cli/_generated/something.mdx so we can keep generated CLI
// docs separate from handwritten ones on disk, but have them side-by-side in the built website.
//
// Note: handwritten paths win over generated ones. If this becomes a problem in practice we could
// check for this scenario in getStaticPaths and throw.
//
// The CLI reference is .mdx where the API reference is .md — the command pages import a shared
// samples include — so both extensions are globbed here.

import type { MarkdownInstance } from 'astro';

export function getStaticPaths() {
  const root = '/src/pages/docs/cli/_generated/';
  const pages = import.meta.glob<MarkdownInstance<Record<string, any>>>(
    '/src/pages/docs/cli/_generated/**/*.{md,mdx}',
    { eager: true }
  );

  return Object.entries(pages).map(([path, page]) => ({
    params: {
      generatedFileName: path.slice(root.length).replace(/\.mdx?$/, ''),
    },
    props: { page },
  }));
}

type Props = { page: MarkdownInstance<Record<string, any>> };

const { page } = Astro.props satisfies Props;
const { Content } = page;
---

<Content />
