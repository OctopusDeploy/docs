---
import { accelerator } from '@lib/accelerator';
import type { Frontmatter } from 'astro-accelerator-utils/types/Frontmatter';
import { SITE } from '@config';
import { Lang } from '@util/Languages';

const stats = new accelerator.statistics('components/ArticleHeader.astro');
stats.start();

// Properties
type Props = {
  lang: string;
  subtitle?: string | null;
  title: string;
  /** Passed to `data-pagefind-weight`. Omitted leaves Pagefind's own heading
   *  weighting alone, which is what every page outside the docs layout wants. */
  searchWeight?: number;
};
const { lang, subtitle, title, searchWeight } = Astro.props satisfies Props;

// Language
const _ = Lang(lang);

// Logic
stats.stop();
---

<header class="header" data-pagefind-weight={searchWeight}>
  <h1 class="header__title">{title}</h1>
  {subtitle && <p class="header__subtitle">{subtitle}</p>}
</header>
