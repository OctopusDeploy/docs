---
// .icon / global/chevron-down from the design system. The glyph is a 10 x
// 6.175 leaf positioned inside a 20 x 20 box, so the box lines up with a 20px
// line of text and the leaf keeps its designed optical offset.
type Props = { class?: string };
const { class: className } = Astro.props satisfies Props;
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 20 20"
  fill="currentColor"
  aria-hidden="true"
>
  <path
    d="M13.825 7.158L10 10.9747L6.175 7.158L5 8.333L10 13.333L15 8.333L13.825 7.158Z"
  ></path>
</svg>
