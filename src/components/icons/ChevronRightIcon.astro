---
// .icon / global/chevron-right from the design system. The glyph is a 6.175 x
// 10 leaf positioned inside a 20 x 20 box, so the box lines up with a 20px
// line of text and the leaf keeps its designed optical offset.
type Props = { class?: string };
const { class: className } = Astro.props satisfies Props;
---

<svg
  class={className}
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 20 20"
  fill="currentColor"
  aria-hidden="true"
>
  <path
    d="M8.333 5L7.158 6.175L10.9747 10L7.158 13.825L8.333 15L13.333 10L8.333 5Z"
  ></path>
</svg>
