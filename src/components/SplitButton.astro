---
import type { HTMLAttributes } from 'astro/types';
import Button from './Button.astro';

export type SplitButtonItem = {
  label: string;
  href: string | URL;
  icon?: string; // URL to an SVG, or a class name, as Button takes
  iconEnd?: string;
};

type Props = HTMLAttributes<'div'> & {
  label: string;
  href: string | URL;
  icon?: string;
  size?: 'xSmall' | 'small' | 'medium';
  importance?: 'default' | 'loud';
  items: SplitButtonItem[];
  menuLabel: string; // accessible name for the caret, which has no text
  target?: string;
  rel?: string;
};

const {
  label,
  href,
  icon,
  size = 'medium',
  importance = 'default',
  items,
  menuLabel,
  target,
  rel,
  class: className,
  ...rest
} = Astro.props satisfies Props;

if (items.length === 0) {
  throw new Error('A SplitButton with no menu items should just be a Button');
}

const iconTag = (name: string | undefined) =>
  !name ? null : name.endsWith('.svg') ? 'img' : 'span';
---

<div class:list={['split-btn', className]} {...rest}>
  <Button
    class="split-btn__primary"
    href={href}
    icon={icon}
    label={label}
    size={size}
    importance={importance}
    target={target}
    rel={rel}
  />
  <details class="split-btn__menu" data-split-menu>
    <Button
      as="summary"
      class="split-btn__toggle"
      icon="fa-solid fa-caret-down"
      size={size}
      importance={importance}
      aria-label={menuLabel}
      data-split-trigger
    />
    <ul class="split-btn__options">
      {
        items.map((item) => {
          const Leading = iconTag(item.icon);
          const Trailing = iconTag(item.iconEnd);
          return (
            <li>
              <a
                class="split-btn__option"
                href={item.href}
                target={target}
                rel={rel}
              >
                {Leading &&
                  (Leading === 'img' ? (
                    <img
                      src={item.icon}
                      alt=""
                      class="split-btn__option-icon"
                      aria-hidden="true"
                    />
                  ) : (
                    <span
                      class={`${item.icon} split-btn__option-icon`}
                      aria-hidden="true"
                    />
                  ))}
                <span class="split-btn__option-label">{item.label}</span>
                {Trailing &&
                  (Trailing === 'img' ? (
                    <img
                      src={item.iconEnd}
                      alt=""
                      class="split-btn__option-icon"
                      aria-hidden="true"
                    />
                  ) : (
                    <span
                      class={`${item.iconEnd} split-btn__option-icon`}
                      aria-hidden="true"
                    />
                  ))}
              </a>
            </li>
          );
        })
      }
    </ul>
  </details>
</div>

<style>
  .split-btn {
    display: inline-flex;
    align-items: stretch;
    /* A flex or grid parent turns `inline-flex` into a block-level box, which
       would then stretch to fill it. Same guard `.btn` uses. */
    max-width: fit-content;
  }

  /* Both halves keep the border `.btn` gives them so nothing clips their focus
     rings; the negative margin collapses the touching pair into the single
     divider the design asks for. */
  .split-btn__menu {
    position: relative;
    margin-inline-start: calc(var(--borderWidth1) * -1);
  }

  /* `:global()` crosses into Button's scope; the `.split-btn` prefix stays scoped */
  .split-btn :global(.split-btn__primary) {
    border-start-end-radius: 0;
    border-end-end-radius: 0;
  }

  .split-btn :global(.split-btn__toggle) {
    height: 100%;
    border-start-start-radius: 0;
    border-end-start-radius: 0;
  }

  /* Raise whichever half is interactive so its border and outline sit above the
     half they overlap. */
  .split-btn :global(.split-btn__primary:hover),
  .split-btn :global(.split-btn__primary:focus-visible),
  .split-btn__menu:has(:hover),
  .split-btn__menu:has(:focus-visible),
  .split-btn__menu[open] {
    z-index: 1;
  }

  .split-btn__menu[open] > :global(.split-btn__toggle) {
    background: var(--colorBackgroundPrimaryPressed);
  }

  .split-btn__options {
    position: absolute;
    z-index: 10;
    inset-block-start: calc(100% + var(--space4));
    inset-inline-end: 0;
    box-sizing: border-box;
    width: var(--split-btn-menu-width, 13rem);
    margin: 0;
    padding: var(--space8) 0;
    list-style: none;
    background: var(--colorMenuListBackgroundDefault);
    border-radius: var(--borderRadiusSmall);
    box-shadow: var(--shadowMedium);
  }

  /* The list is wider than the control it hangs from, so which side it opens
     towards depends on where the control has ended up: at the end of a row on
     one line, or at the start of its own once the row wraps. Anchored so the
     browser picks the side with room, which a width breakpoint cannot do. */
  @supports (anchor-name: --a) {
    .split-btn {
      anchor-name: --split-btn;
    }

    /* Fixed so the viewport is what the browser measures the room against; the
       anchor keeps it tracking the button through a scroll. */
    .split-btn__options {
      position: fixed;
      position-anchor: --split-btn;
      position-area: block-end span-inline-start;
      position-try-fallbacks: flip-inline;
      inset: auto;
      margin-block-start: var(--space4);
    }
  }

  .split-btn__option {
    display: flex;
    align-items: center;
    gap: var(--space4);
    /* The page has no universal border-box rule, so min-height would otherwise
       measure the content alone and the padding would sit outside the row. */
    box-sizing: border-box;
    /* 2.25rem is the medium button's height: the design system has no compact
       MenuList to take this from, so it borrows the step the buttons use. */
    min-height: 2.25rem;
    padding: var(--space4) var(--space16);
    color: var(--colorTextLinkDefault);
    font: var(--textBodyRegularLarge);
  }

  .split-btn__option:hover,
  .split-btn__option:focus-visible {
    background: var(--colorMenuListBackgroundHover);
  }

  .split-btn__option-icon {
    display: inline-block;
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
  }

  .split-btn__option-label {
    text-decoration: underline;
  }
</style>
